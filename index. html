"script.js": r'''const STORAGE_KEY = "characterVoice.characters.v1";
const HISTORY_KEY = "characterVoice.history.v1";

const defaults = [
  {id:"sample-ryoshu",name:"良秀（サンプル）",work:"Limbus Company / サンプル設定",first:"私",second:"お前",personality:"冷静・寡黙・芸術家気質",speech:"短文を好む。冗長な表現を避け、短く鋭い言い回しを使う。これは再現用の簡易サンプル。",rules:"今日は=>本日。\n疲れた=>疲労。\n帰りたい=>帰還する。\nもう帰りたい=>帰還する。\nです。=>だ。\nます。=>る。"},
  {id:"sample-cheerful",name:"明るいキャラ（サンプル）",work:"オリジナル用テンプレート",first:"私",second:"きみ",personality:"明るい・親しみやすい",speech:"明るく親しみやすい。語尾に感情を乗せる。",rules:"こんにちは=>やっほー！\nありがとう=>ありがとね！\nです。=>だよ！\nます。=>るね！"},
  {id:"sample-polite",name:"丁寧なキャラ（サンプル）",work:"オリジナル用テンプレート",first:"私",second:"あなた",personality:"礼儀正しい・落ち着いている",speech:"丁寧で落ち着いた敬語。",rules:"お前=>あなた\nだよ。=>です。\nだね。=>ですね。\nしてくれ=>してください"}
];

let characters = loadCharacters();
let history = loadHistory();
let selectedId = characters[0]?.id;
const $ = id => document.getElementById(id);

function loadCharacters(){try{const v=JSON.parse(localStorage.getItem(STORAGE_KEY));return Array.isArray(v)&&v.length?v:structuredClone(defaults)}catch{return structuredClone(defaults)}}
function saveCharacters(){localStorage.setItem(STORAGE_KEY,JSON.stringify(characters))}
function loadHistory(){try{return JSON.parse(localStorage.getItem(HISTORY_KEY))||[]}catch{return []}}
function saveHistoryData(){localStorage.setItem(HISTORY_KEY,JSON.stringify(history.slice(0,20)))}
function selectedCharacter(){return characters.find(c=>c.id=== $("characterSelect").value)||characters[0]}
function escapeHtml(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function toast(message){const el=$("toast");el.textContent=message;el.classList.add("show");clearTimeout(toast.timer);toast.timer=setTimeout(()=>el.classList.remove("show"),2200)}
function renderSelect(){const select=$("characterSelect");select.innerHTML=characters.map(c=>`<option value="${escapeHtml(c.id)}">${escapeHtml(c.name)}</option>`).join("");if(characters.some(c=>c.id===selectedId))select.value=selectedId;renderSummary()}
function renderSummary(){const c=selectedCharacter();$("characterSummary").textContent=c?`${c.work||"分類なし"}｜一人称：${c.first||"未設定"}｜二人称：${c.second||"未設定"}｜${c.personality||"性格未設定"}`:"キャラクターを登録してください。"}
function replaceAllLiteral(text,from,to){return from?text.split(from).join(to):text}
function convertText(){
  const original=$("inputText").value;
  if(!original.trim()){toast("変換する文章を入力してください");return}
  const c=selectedCharacter();if(!c){toast("キャラクターを登録してください");return}
  let result=original;
  const strength=$("styleSelect").value;
  const rules=(c.rules||"").split(/\n/).map(line=>{const i=line.indexOf("=>");return i<0?null:[line.slice(0,i).trim(),line.slice(i+2).trim()]}).filter(r=>r&&r[0]);
  if(strength==="light"){rules.slice(0,Math.ceil(rules.length/2)).forEach(([a,b])=>result=replaceAllLiteral(result,a,b))}
  else rules.forEach(([a,b])=>result=replaceAllLiteral(result,a,b));
  if(strength==="strong"){
    if(c.first && c.first!=="私" && !result.startsWith(c.first+"：")) result=result.replace(/^(私は|僕は|俺は|私は|私が|僕が|俺が)/,c.first+"は");
    if(c.second && c.second!=="あなた") result=replaceAllLiteral(result,"あなた",c.second);
  }
  const emotion=$("emotionSelect").value, situation=$("situationSelect").value, personality=$("personalitySelect").value;
  if(emotion==="happy" && !/[！!♪]$/.test(result.trim())) result=result.trim()+"！";
  if(emotion==="angry" && !/[！!。]$/.test(result.trim())) result=result.trim()+"。";
  if(emotion==="sad" && !/[………。]$/.test(result.trim())) result=result.trim()+"……";
  if(emotion==="serious" && !/[。！？!?]$/.test(result.trim())) result=result.trim()+"。";
  if(personality==="polite" && !/[。！？!?]$/.test(result.trim())) result=result.trim()+"。";
  if(personality==="cheerful" && !/[！!♪]$/.test(result.trim())) result=result.trim()+"！";
  if(personality==="quiet") result=result.replace(/！+/g,"。").replace(/です。/g,"です。");
  if(situation==="battle") result=result.replace(/お願いします/g,"頼む").replace(/危ない/g,"危険だ");
  if(situation==="urgent") result=result.replace(/してください/g,"してくれ").replace(/お願いします/g,"頼む");
  $("outputText").value=result;
  toast("口調を変換しました");
}
function renderHistory(){const el=$("historyList");if(!history.length){el.innerHTML='<p class="hint">まだ履歴はありません。</p>';return}el.innerHTML=history.slice(0,8).map((h,i)=>`<article class="history-item"><strong>${escapeHtml(h.name)} · ${escapeHtml(h.date)}</strong><p>${escapeHtml(h.output)}</p><div class="button-row"><button class="secondary-btn" data-history-copy="${i}">コピー</button><button class="secondary-btn" data-history-use="${i}">入力に戻す</button></div></article>`).join("")}
function openManage(){renderCharacterList();$("manageDialog").showModal()}
function renderCharacterList(){const list=$("characterList");list.innerHTML=characters.map(c=>`<button class="character-choice ${c.id===$("characterId").value?"active":""}" data-edit-id="${escapeHtml(c.id)}">${escapeHtml(c.name)}<small>${escapeHtml(c.work||"分類なし")}</small></button>`).join("")}
function resetForm(){ $("characterForm").reset();$("characterId").value="";$("deleteCharacterBtn").disabled=true;renderCharacterList()}
function fillForm(c){$("characterId").value=c.id;$("nameInput").value=c.name||"";$("workInput").value=c.work||"";$("firstPersonInput").value=c.first||"";$("secondPersonInput").value=c.second||"";$("personalityInput").value=c.personality||"";$("speechInput").value=c.speech||"";$("rulesInput").value=c.rules||"";$("deleteCharacterBtn").disabled=false;renderCharacterList()}
function saveCharacter(e){e.preventDefault();const id=$("characterId").value||("custom-"+Date.now());const c={id,name:$("nameInput").value.trim(),work:$("workInput").value.trim(),first:$("firstPersonInput").value.trim(),second:$("secondPersonInput").value.trim(),personality:$("personalityInput").value.trim(),speech:$("speechInput").value.trim(),rules:$("rulesInput").value};const idx=characters.findIndex(x=>x.id===id);if(idx>=0)characters[idx]=c;else characters.push(c);selectedId=id;saveCharacters();renderSelect();renderCharacterList();fillForm(c);toast("キャラクターを保存しました")}
function deleteCharacter(){const id=$("characterId").value;if(!id)return;const c=characters.find(x=>x.id===id);if(!confirm(`「${c?.name||"このキャラクター"}」を削除しますか？`))return;characters=characters.filter(x=>x.id!==id);if(!characters.length)characters=[{id:"new-default",name:"新しいキャラクター",work:"オリジナル",first:"私",second:"あなた",personality:"",speech:"",rules:""}];selectedId=characters[0].id;saveCharacters();renderSelect();resetForm();toast("削除しました")}
$("characterSelect").addEventListener("change",()=>{selectedId=$("characterSelect").value;renderSummary()});
$("inputText").addEventListener("input",()=>$("inputCount").textContent=$("inputText").value.length+"文字");
$("convertBtn").addEventListener("click",convertText);
$("clearInputBtn").addEventListener("click",()=>{$("inputText").value="";$("inputCount").textContent="0文字"});
$("copyBtn").addEventListener("click",async()=>{const t=$("outputText").value;if(!t){toast("コピーする結果がありません");return}try{await navigator.clipboard.writeText(t);toast("コピーしました")}catch{$("outputText").readOnly=false;$("outputText").select();document.execCommand("copy");$("outputText").readOnly=true;toast("コピーしました")}});
$("useResultBtn").addEventListener("click",()=>{$("inputText").value=$("outputText").value;$("inputCount").textContent=$("inputText").value.length+"文字";toast("入力欄に戻しました")});
$("saveHistoryBtn").addEventListener("click",()=>{if(!$("outputText").value){toast("保存する結果がありません");return}history.unshift({name:selectedCharacter()?.name||"不明",date:new Date().toLocaleString("ja-JP"),input:$("inputText").value,output:$("outputText").value});history=history.slice(0,20);saveHistoryData();renderHistory();toast("履歴に保存しました")});
$("clearHistoryBtn").addEventListener("click",()=>{if(confirm("履歴をすべて削除しますか？")){history=[];saveHistoryData();renderHistory();toast("履歴を削除しました")}});
$("manageBtn").addEventListener("click",()=>{resetForm();openManage()});
$("closeManageBtn").addEventListener("click",()=>$("manageDialog").close());
$("newCharacterBtn").addEventListener("click",resetForm);
$("characterList").addEventListener("click",e=>{const b=e.target.closest("[data-edit-id]");if(!b)return;const c=characters.find(x=>x.id===b.dataset.editId);if(c)fillForm(c)});
$("characterForm").addEventListener("submit",saveCharacter);
$("deleteCharacterBtn").addEventListener("click",deleteCharacter);
$("historyList").addEventListener("click",async e=>{const cp=e.target.closest("[data-history-copy]");const use=e.target.closest("[data-history-use]");if(cp){const h=history[Number(cp.dataset.historyCopy)];if(h){try{await navigator.clipboard.writeText(h.output);toast("コピーしました")}catch{toast("コピーできませんでした")}}}if(use){const h=history[Number(use.dataset.historyUse)];if(h){$("inputText").value=h.input;$("outputText").value=h.output;$("inputCount").textContent=h.input.length+"文字";window.scrollTo({top:0,behavior:"smooth"})}}});
$("themeBtn").addEventListener("click",()=>{document.body.classList.toggle("light");localStorage.setItem("characterVoice.light",document.body.classList.contains("light")?"1":"0")});
if(localStorage.getItem("characterVoice.light")==="1")document.body.classList.add("light");
if(!localStorage.getItem(STORAGE_KEY))saveCharacters();
renderSelect();renderHistory();$("deleteCharacterBtn").disabled=true;
'''
}

for name, content in files.items():
    with open(os.path.join(base, name), "w", encoding="utf-8") as f:
        f.write(content)

zip_path = "/mnt/data/character-voice.zip"
with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as z:
    for name in files:
        z.write(os.path.join(base, name), arcname=f"character-voice/{name}")

print("Created:", zip_path)
